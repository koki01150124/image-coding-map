{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/image-compression-map/node.schema.json",
  "title": "論文・手法ノード",
  "description": "data/nodes/<id>.json の形式．未確認の項目は推測で埋めず null とする．",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "kind", "short_name", "bib_key", "bibliography", "year", "domains",
    "source_representation", "channel_models", "transmission", "contributions",
    "training", "metrics", "strengths", "limitations", "relations", "verification"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$", "description": "ファイル名と一致するID"},
    "kind": {"enum": ["paper", "standard", "software", "scheme", "unpublished"]},
    "short_name": {"type": "string", "minLength": 1, "maxLength": 40},
    "aliases": {"type": "array", "items": {"type": "string"}, "description": "検索用の別名"},
    "bib_key": {"type": ["string", "null"], "description": "survey/library.json の引用キー．書誌情報が API 由来の場合に必須"},
    "bibliography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "authors", "year", "venue", "doi", "arxiv", "url", "source"],
      "properties": {
        "title": {"type": ["string", "null"]},
        "authors": {"type": ["array", "null"], "items": {"type": "string"}},
        "year": {"type": ["integer", "null"]},
        "venue": {"type": ["string", "null"]},
        "doi": {"type": ["string", "null"]},
        "arxiv": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"], "pattern": "^https?://"},
        "source": {"type": "string", "description": "書誌情報の出典（library または確認した一次資料）"}
      }
    },
    "year": {"type": "integer", "minimum": 1900, "maximum": 2100, "description": "マップ上の発表年"},
    "year_note": {"type": "string", "description": "year が bibliography.year と異なる場合の根拠"},
    "domains": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["traditional", "lic", "generative", "sscc", "analog_jscc", "digital_jscc", "channel_coding"]},
      "description": "研究分野．先頭が主分野"
    },
    "tags": {"type": "array", "items": {"type": "string"}, "description": "研究課題などの自由なタグ"},
    "source_representation": {"type": ["string", "null"], "description": "情報源表現・潜在表現"},
    "channel_models": {
      "type": ["array", "null"],
      "items": {"enum": ["AWGN", "Rayleigh", "BSC", "BEC", "B-DMC", "feedback", "general"]},
      "description": "扱う通信路モデル．通信路を扱わない場合は空配列，未確認は null"
    },
    "transmission": {"enum": ["analog", "digital", "not_applicable", null]},
    "contributions": {"type": ["array", "null"], "items": {"type": "string"}},
    "training": {"type": ["string", "null"], "description": "学習方法．学習を伴わない手法は「学習なし」と記す"},
    "metrics": {"type": ["array", "null"], "items": {"type": "string"}},
    "strengths": {"type": ["array", "null"], "items": {"type": "string"}},
    "limitations": {"type": ["array", "null"], "items": {"type": "string"}},
    "code_url": {"type": "string", "pattern": "^https?://"},
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "type", "note", "evidence"],
        "properties": {
          "target": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "type": {"type": "string"},
          "note": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "detail"],
            "properties": {
              "kind": {"enum": ["abstract", "full_text", "official_page", "source_code", "project_doc"]},
              "detail": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_level", "notes"],
      "properties": {
        "read_level": {"enum": ["abstract", "full_text_scan", "official_page", "project_doc"]},
        "notes": {"type": "string"}
      }
    }
  }
}
